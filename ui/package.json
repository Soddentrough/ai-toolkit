{
  "name": "ai-toolkit-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n WORKER,UI \"tsx watch --tsconfig tsconfig.worker.json cron/worker.ts\" \"tsx watch --tsconfig tsconfig.worker.json cron/fileServer.ts dev --port 3000\"",
    "build": "tsc -p tsconfig.worker.json && next build",
    "start": "concurrently -k --restart-tries -1 --restart-after 1000 -n WORKER,UI \"node dist/cron/worker.js\" \"node dist/cron/fileServer.js start --port 8675\"",
    "install_deps": "npm install --no-save --no-audit --no-fund",
    "db_build_start": "npm run update_db && npm run build && npm run start",
    "build_and_start": "npm run install_deps && npm run db_build_start",
    "lint": "next lint",
    "update_db": "npx prisma generate && npx prisma db push",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss}\"",
    "check_extensions": "tsc -p ../tsconfig.json"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.19.3",
    "archiver": "^8.0.0",
    "axios": "^1.20.0",
    "classnames": "^2.5.1",
    "lucide-react": "^0.475.0",
    "next": "^16.4.2",
    "node-cache": "^5.1.2",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^14.4.1",
    "react-global-hooks": "^1.3.5",
    "react-icons": "^5.7.0",
    "react-select": "^5.10.2",
    "react-virtuoso": "^4.18.19",
    "react-zoom-pan-pinch": "^4.2.0",
    "systeminformation": "^5.33.16",
    "uplot": "^1.6.32",
    "uuid": "^11.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.2.5",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-basic": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "dompurify": "^3.4.17"
  },
  "optionalDependencies": {
    "macstats": "^4.2.0"
  },
  "prettier": "prettier-basic"
}
